<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سباق صواريخ الفضاء - ملك جدول الضرب</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="config.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background: #0b0f19; color: white; margin: 0; padding: 0; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; position: relative; }
        .game-container { width: 100%; max-width: 600px; height: 100vh; background: radial-gradient(circle at center, #1e1b4b 0%, #090d16 100%); position: relative; box-shadow: 0 0 40px rgba(79, 70, 229, 0.3); display: flex; flex-direction: column; justify-content: space-between; border-left: 2px solid #3730a3; border-right: 2px solid #3730a3; box-sizing: border-box; overflow: hidden; padding-bottom: 25px; }

        .hud { display: flex; justify-content: space-between; padding: 12px 18px; background: rgba(15, 23, 42, 0.9); font-size: 15px; font-weight: bold; border-bottom: 2px solid #4f46e5; z-index: 10; position: relative; }
        .hud span { color: #818cf8; }

        .space-arena { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 20px 15px; box-sizing: border-box; }

        .rocket-track { position: relative; width: 100%; height: 180px; border-left: 2px dashed rgba(255,255,255,0.2); border-right: 2px dashed rgba(255,255,255,0.2); display: flex; justify-content: center; align-items: flex-end; }
        .rocket { font-size: 60px; transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); position: absolute; bottom: 10px; }
        .rocket.launch { animation: rocketBoost 0.4s ease-in-out; }

        @keyframes rocketBoost {
            0% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-30px) scale(1.15); }
            100% { transform: translateY(0) scale(1); }
        }

        .question-card { background: rgba(30, 27, 75, 0.85); border: 2px solid #6366f1; border-radius: 15px; padding: 15px 25px; text-align: center; box-shadow: 0 0 20px rgba(99, 102, 241, 0.3); width: 85%; }
        .question-title { color: #a5b4fc; font-size: 14px; margin-bottom: 5px; }
        .question-text { font-size: 36px; font-weight: 900; color: #ffffff; letter-spacing: 2px; }

        /* منطقة الإدخال السريع بالنمط السابق */
        .input-box-container { display: flex; gap: 10px; justify-content: center; align-items: center; width: 100%; max-width: 400px; margin-top: 10px; }
        .answer-input { width: 140px; padding: 10px; font-size: 28px; font-weight: bold; text-align: center; border: 3px solid #6366f1; border-radius: 12px; background: rgba(15, 23, 42, 0.9); color: #fff; font-family: 'Cairo'; outline: none; }
        .submit-btn { background: #4f46e5; color: white; border: none; padding: 12px 25px; font-size: 20px; font-weight: bold; border-radius: 12px; cursor: pointer; transition: 0.2s; font-family: 'Cairo'; }
        .submit-btn:hover { background: #4338ca; transform: scale(1.05); }

        .numpad-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 100%; max-width: 280px; margin-top: 10px; }
        .num-btn { background: rgba(30, 27, 75, 0.9); border: 1px solid #4f46e5; color: white; padding: 10px; font-size: 20px; font-weight: bold; border-radius: 8px; cursor: pointer; transition: 0.1s; font-family: 'Cairo'; }
        .num-btn:active { background: #6366f1; transform: scale(0.95); }

        .modal { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(9, 13, 22, 0.97); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; text-align: center; padding: 25px; box-sizing: border-box; }
        .modal h1 { color: #818cf8; font-size: 28px; margin-bottom: 15px; }

        .btn { background: #4f46e5; color: white; border: none; padding: 12px 35px; font-size: 18px; font-weight: bold; border-radius: 10px; cursor: pointer; transition: 0.3s; font-family: 'Cairo'; }
        .btn:hover { background: #4338ca; transform: translateY(-2px); }
        .hidden { display: none !important; }

        /* التوقيع الرسمي في الأسفل */
        footer.author-footer {
            position: absolute;
            bottom: 5px;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 12px;
            color: #818cf8;
            background: rgba(11, 15, 25, 0.85);
            pointer-events: none;
            z-index: 100;
            font-weight: bold;
            padding: 3px 0;
        }
    </style>
</head>
<body>

    <div class="game-container">
        <div class="hud">
            <div>الطيار: <span id="playerName">بطل</span></div>
            <div>⏱️ الوقت: <span id="timerVal">٦٠</span>ث</div>
            <div>🚀 النقاط: <span id="scoreVal">٠</span></div>
        </div>

        <div class="space-arena">
            <div class="rocket-track">
                <div class="rocket" id="rocketIcon">🚀</div>
            </div>

            <div class="question-card">
                <div class="question-title">حساب سرعة الانطلاق</div>
                <div class="question-text" id="questionDisplay">؟ × ؟ = ؟</div>
            </div>

            <div class="input-box-container">
                <input type="text" id="userAnswerInput" class="answer-input" placeholder="الجواب" readonly>
                <button class="submit-btn" onclick="submitAnswer()">انطلاق 🚀</button>
            </div>

            <!-- لوحة الأرقام السريعة بالشكل السابق -->
            <div class="numpad-grid">
                <button class="num-btn" onclick="pressNum('1')">١</button>
                <button class="num-btn" onclick="pressNum('2')">٢</button>
                <button class="num-btn" onclick="pressNum('3')">٣</button>
                <button class="num-btn" onclick="pressNum('4')">٤</button>
                <button class="num-btn" onclick="pressNum('5')">٥</button>
                <button class="num-btn" onclick="pressNum('6')">٦</button>
                <button class="num-btn" onclick="pressNum('7')">٧</button>
                <button class="num-btn" onclick="pressNum('8')">٨</button>
                <button class="num-btn" onclick="pressNum('9')">٩</button>
                <button class="num-btn" style="background:#ef4444;" onclick="clearInput()">مسح ⌫</button>
                <button class="num-btn" onclick="pressNum('0')">٠</button>
                <button class="num-btn" style="background:#10b981;" onclick="submitAnswer()">تأكيد ↵</button>
            </div>
        </div>

        <div class="modal hidden" id="gameOverModal">
            <h1>انتهت الرحلة الفضائية! 🌌</h1>
            <p id="finalScoreText" style="font-size: 20px; margin-bottom: 20px;">جمعت ٠ نقطة</p>
            <p id="saveStatus" style="color: #38bdf8; font-size: 14px; margin-bottom: 20px;"></p>

            <div style="display: flex; gap: 15px;">
                <button class="btn" onclick="restartGame()">محاولة جديدة 🚀</button>
                <button class="btn" style="background: #059669;" onclick="goToMain()">الرئيسية 🏠</button>
            </div>
        </div>
    </div>

    <!-- التوقيع الرسمي أسفل الصفحة -->
    <footer class="author-footer">
        إعداد أ. صادق القلعاوي | مدرسة اليرموك الابتدائية للبنين 🏫✨
    </footer>

    <script>
        let studentData = null;
        try { studentData = JSON.parse(localStorage.getItem('current_student')); } catch (e) { studentData = null; }

        if (!studentData || !studentData.name) {
            alert('الرجاء اختيار اسمك أولاً للبدء!');
            window.location.href = 'student.html';
        } else {
            document.getElementById('playerName').textContent = studentData.name;
        }

        function toArabicNum(num) {
            const arabicNumbers = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
            return String(num).replace(/\d/g, (d) => arabicNumbers[d]);
        }

        function toEnglishNum(numStr) {
            return String(numStr)
                .replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d))
                .replace(/[0-9]/g, d => d);
        }

        let score = 0;
        let timeLeft = 60;
        let timerInterval = null;
        let currentCorrectAnswer = 0;
        let maxTable = 10;
        let currentInput = "";

        function initSettings() {
            const cls = String(studentData.cls || '').trim();
            if (cls.includes('٤') || cls.includes('4') || cls.startsWith('4')) maxTable = 6;
            else if (cls.includes('٥') || cls.includes('5') || cls.includes('٦') || cls.includes('6')) maxTable = 12;
            else maxTable = 10;

            startGame();
        }

        function startGame() {
            score = 0;
            timeLeft = 60;
            currentInput = "";
            document.getElementById('userAnswerInput').value = "";
            document.getElementById('scoreVal').textContent = toArabicNum(0);
            document.getElementById('timerVal').textContent = toArabicNum(60);
            document.getElementById('gameOverModal').classList.add('hidden');

            generatePuzzle();

            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timeLeft--;
                document.getElementById('timerVal').textContent = toArabicNum(timeLeft);
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    endGame();
                }
            }, 1000);
        }

        function pressNum(digit) {
            if (currentInput.length < 4) {
                currentInput += digit;
                document.getElementById('userAnswerInput').value = toArabicNum(currentInput);
            }
        }

        function clearInput() {
            currentInput = "";
            document.getElementById('userAnswerInput').value = "";
        }

        function generatePuzzle() {
            currentInput = "";
            document.getElementById('userAnswerInput').value = "";
            
            let num1 = Math.floor(Math.random() * (maxTable - 1)) + 2;
            let num2 = Math.floor(Math.random() * 10) + 1;
            currentCorrectAnswer = num1 * num2;

            document.getElementById('questionDisplay').textContent = `${toArabicNum(num1)} × ${toArabicNum(num2)}`;
        }

        function submitAnswer() {
            if (!currentInput) return;

            const userVal = parseInt(toEnglishNum(currentInput));
            const rocket = document.getElementById('rocketIcon');

            if (userVal === currentCorrectAnswer) {
                score += 100;
                document.getElementById('scoreVal').textContent = toArabicNum(score);
                rocket.classList.add('launch');
                setTimeout(() => rocket.classList.remove('launch'), 400);
            } else {
                score = Math.max(0, score - 30);
                document.getElementById('scoreVal').textContent = toArabicNum(score);
            }
            generatePuzzle();
        }

        async function endGame() {
            document.getElementById('gameOverModal').classList.remove('hidden');
            document.getElementById('finalScoreText').textContent = `أحسنت يا ${studentData.name}! جمعت ${toArabicNum(score)} نقطة.`;
            document.getElementById('saveStatus').textContent = 'جاري حفظ النتيجة في السحابة...';

            try {
                const { error } = await supabaseClient.from('rocket_scores').insert([{
                    student_name: studentData.name,
                    cls: studentData.cls,
                    points: score,
                    weekly_points: score
                }]);

                if (error) throw error;
                document.getElementById('saveStatus').textContent = '✅ تم حفظ النتيجة بنجاح في السحابة!';
            } catch (err) {
                document.getElementById('saveStatus').textContent = '⚠️ تعذر حفظ النتيجة بالسحابة.';
            }
        }

        function restartGame() { startGame(); }
        function goToMain() { window.location.href = 'student.html'; }

        // تمكين إدخال الأرقام عبر لوحة المفاتيح
        document.addEventListener('keydown', (e) => {
            if (e.key >= '0' && e.key <= '9') pressNum(e.key);
            else if (e.key === 'Backspace') clearInput();
            else if (e.key === 'Enter') submitAnswer();
        });

        initSettings();
    </script>
</body>
</html>
